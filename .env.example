# Dubriani AI Agent — environment variable template.
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored. NEVER paste real secrets into chat or commits.

# ── Anthropic (Claude) ──────────────────────────────────────────
# Backs the workflow's Anthropic header-auth credential in N8N.
ANTHROPIC_API_KEY=

# ── Telegram approval bot ───────────────────────────────────────
# Injected into the workflow via {{ $env.TELEGRAM_BOT_TOKEN }} and
# used by scripts/setup-telegram-webhook.sh.
TELEGRAM_BOT_TOKEN=
# Admin Telegram user ID — the ONLY account allowed to approve drafts.
# Not a secret (an ID grants no access); kept here as config.
TELEGRAM_ADMIN_USER_ID=5532831477

# ── WAHA (WhatsApp HTTP API) ────────────────────────────────────
WAHA_API_KEY=
WAHA_BASE_URL=https://waha.13-63-82-112.sslip.io

# ── Supermemory ─────────────────────────────────────────────────
# Retrieve from N8N -> Credentials -> the Supermemory credential
# (type httpBearerAuth) -> reveal token. Needed for Step 2 only.
SUPERMEMORY_API_KEY=

# ── N8N ─────────────────────────────────────────────────────────
N8N_BASE_URL=https://n8n.13-63-82-112.sslip.io
# Public REST API key (N8N -> Settings -> n8n API). Needed to
# create credentials via curl — see docs/credentials-map.md.
N8N_API_KEY=

# ── N8N credential IDs ──────────────────────────────────────────
# Fill in AFTER the credentials exist in N8N. build_workflow.py
# --externalize bakes these into the workflow's credential refs.
# Leave blank to emit a re-pick-on-import placeholder instead.
N8N_CRED_ANTHROPIC_ID=
N8N_CRED_WAHA_ID=
N8N_CRED_SUPERMEMORY_ID=aKreN1AB4QYfQKlz
