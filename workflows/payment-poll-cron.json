{
  "name": "Dubriani Payment Poll Cron",
  "nodes": [
    {
      "id": "pp-schedule-2026-05-24",
      "name": "Schedule (every 2 min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        320
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      }
    },
    {
      "id": "pp-poll-2026-05-24",
      "name": "Poll Payments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        464,
        320
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "http://172.18.0.1:8788/poll-payments",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"window_hours\": 24, \"page_size\": 50 }",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "IgIcvPoibuAayVDx",
          "name": "Hermes Bridge"
        }
      }
    },
    {
      "id": "pp-anything-2026-05-24",
      "name": "Anything New?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        688,
        320
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "pp-cond-1",
              "leftValue": "={{ ($json.matched.length || 0) + ($json.unmatched.length || 0) }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "pp-split-matched-2026-05-24",
      "name": "Split Matched",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        912,
        240
      ],
      "parameters": {
        "fieldToSplitOut": "matched",
        "options": {}
      }
    },
    {
      "id": "pp-send-matched-2026-05-24",
      "name": "Notify Matched",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1136,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": 5532831477,\n  \"parse_mode\": \"HTML\",\n  \"text\": {{ JSON.stringify(\n    '\\ud83d\\udcb0 <b>PAYMENT RECEIVED</b>' + ($json.payer_mismatch ? '  \\u26a0\\ufe0f payer \\u2260 customer' : '') + '\\n' +\n    'Customer: <b>' + ($json.customer_name || $json.customer_id || '(unknown)') + '</b>\\n' +\n    (($json.payer_info && ($json.payer_info.first_name || $json.payer_info.email))\n      ? ('Paid by: ' + [($json.payer_info.first_name + ' ' + $json.payer_info.last_name).trim(), $json.payer_info.email, ($json.payer_info.phone_number ? '+' + $json.payer_info.phone_number : '')].filter(x=>x).join(' \\u00b7 ') + '\\n')\n      : '') +\n    'Amount: AED ' + ($json.total || '?') + '\\n' +\n    'Method: ' + ($json.payment_method || 'unknown') + '\\n' +\n    'Booking: ' + ($json.summary || '(no summary)') + '\\n' +\n    '\\u2192 promoted to \\u2705 CONFIRMED  <i>(via ' + ($json.matched_via || 'unknown') + ')</i>' +\n    ($json.payer_mismatch ? '\\n\\n\\ud83d\\udccb Payer info logged \\u2014 link to customer in CRM.' : '')\n  ) }}\n}",
        "options": {
          "timeout": 8000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "pp-split-unmatched-2026-05-24",
      "name": "Split Unmatched",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        912,
        400
      ],
      "parameters": {
        "fieldToSplitOut": "unmatched",
        "options": {}
      }
    },
    {
      "id": "pp-send-unmatched-2026-05-24",
      "name": "Notify Unmatched",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1136,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": 5532831477,\n  \"parse_mode\": \"HTML\",\n  \"text\": {{ JSON.stringify(\n    '\\ud83d\\udcb0 <b>PAYMENT RECEIVED</b> (unmatched)\\n' +\n    'Amount: AED ' + ($json.total || '?') + '\\n' +\n    'Method: ' + ($json.payment_method || 'unknown') + '\\n' +\n    'Time: ' + ($json.created_at || '?') + '\\n' +\n    (($json.payer_info && ($json.payer_info.first_name || $json.payer_info.email))\n      ? ('From: ' + [($json.payer_info.first_name + ' ' + $json.payer_info.last_name).trim(), $json.payer_info.email, ($json.payer_info.phone_number ? '+' + $json.payer_info.phone_number : '')].filter(x=>x).join(' \\u00b7 ') + '\\n')\n      : '') +\n    'Reference: <code>' + ($json.charge_id || '?').slice(0, 8) + '...</code>\\n\\n' +\n    'Check Nomod dashboard to identify customer + run <code>/label name CONFIRMED</code> manually.'\n  ) }}\n}",
        "options": {
          "timeout": 8000
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
